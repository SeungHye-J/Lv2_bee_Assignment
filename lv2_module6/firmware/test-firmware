#!/bin/bash
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

# OpenCR beebot_opencr 시리얼 테스트
#
#   ./test-firmware                         # 상태(S) 읽기만 함 — 로봇 안 움직임
#   ./test-firmware --raw                   # 받은 S 줄 원문 출력
#   ./test-firmware --port /dev/ttyACM0     # 포트 지정 (기본: /dev/opencr → /dev/ttyACM0)
#   ./test-firmware --lines 10              # 읽을 S 줄 수
#
#   ./test-firmware --hold --yes            # 현재 자세 유지 명령을 한 번 보냄
#   ./test-firmware --send 'C,0,0,0,0,0,0,0,0' --yes
#   ./test-firmware --arm joint1 0.05 --yes # joint1만 현재 자세에서 +0.05 rad
#   ./test-firmware --gripper 0.005 --yes   # 그리퍼 폭 5 mm
#
# 주의:
#   - --arm/--gripper/--send는 실제로 모터를 움직입니다. 주변을 비우고 작은 값부터.
#   - 모터 8개(바퀴 1·2, 팔 11~15, 그리퍼 16)가 모두 1 Mbps/Protocol 2.0으로
#     연결되어 있어야 펌웨어가 C 명령을 받습니다. 하나라도 없으면 S만 나옵니다.
#   - ROS(controller_manager)나 다른 시리얼 모니터가 포트를 잡고 있으면 종료하세요.
set -euo pipefail

PORT="${PORT:-}"
LINES=3
RAW=0
HOLD=0
SEND=""
ARM=""
ARM_DELTA=""
GRIPPER=""
YES=0
TIMEOUT=2

usage() {
  sed -n '6,22p' "$0"
}

while (($#)); do
  case "$1" in
    --port) PORT=$2; shift 2 ;;
    --lines) LINES=$2; shift 2 ;;
    --raw) RAW=1; shift ;;
    --hold) HOLD=1; shift ;;
    --send) SEND=$2; shift 2 ;;
    --arm) ARM=$2; ARM_DELTA=$3; shift 3 ;;
    --gripper) GRIPPER=$2; shift 2 ;;
    --yes) YES=1; shift ;;
    --timeout) TIMEOUT=$2; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) echo "모르는 옵션: $1"; usage; exit 2 ;;
  esac
done

if [ -z "$PORT" ]; then
  if [ -e /dev/opencr ]; then PORT=/dev/opencr; else PORT=/dev/ttyACM0; fi
fi

[ -e "$PORT" ] || { echo "FAIL: 포트 없음: $PORT"; echo "  ls -l /dev/opencr /dev/ttyACM0"; exit 2; }
[ -r "$PORT" ] || { echo "FAIL: 읽기 권한 없음: $PORT"; echo "  sudo usermod -aG dialout $USER  (재로그인)"; exit 2; }

# ROS가 포트를 잡고 있으면 명령이 섞인다.
if pgrep -f 'ros2_control_node|controller_manager' >/dev/null 2>&1; then
  echo "FAIL: ROS controller_manager가 실행 중 — 포트를 같이 쓸 수 없습니다."
  echo "      ROS(start.sh)를 종료한 뒤 다시 실행하세요."
  exit 2
fi

if [ -n "$ARM" ] || [ -n "$GRIPPER" ] || [ -n "$SEND" ] || [ "$HOLD" = 1 ]; then
  [ -w "$PORT" ] || { echo "FAIL: 쓰기 권한 없음: $PORT"; exit 2; }
  if [ "$YES" != 1 ]; then
    echo "WARNING: 모터가 움직일 수 있습니다: $PORT"
    echo "         주변을 비우고, 작은 값부터 테스트하세요."
    read -r -p "계속할까요? [y/N] " answer
    case "$answer" in y | Y | yes | YES) ;; *) echo "취소"; exit 1 ;; esac
  fi
fi

say() { printf '%s\n' "$*"; }

# USB CDC라 baud는 참고값이지만, raw 모드로 맞춘다.
if ! stty -F "$PORT" raw -echo 115200 2>/dev/null; then
  echo "FAIL: 시리얼 포트 설정 실패: $PORT"
  echo "  권한(dialout)과 다른 프로그램의 포트 점유를 확인하세요."
  exit 2
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

read_status() {
  : >"$tmp"
  timeout "$TIMEOUT" cat "$PORT" >"$tmp" 2>/dev/null || true
}

# 시리얼을 timeout으로 끊으면 마지막 줄이 중간에서 잘릴 수 있다.
# S 필드가 정확히 32개인 "완전한 줄"만 사용한다.
complete_s_lines() {
  awk -F, '
    /^S,/ {
      line = $0;
      sub(/\r$/, "", line);
      n = split(line, a, ",");
      if (n == 33) print line;
    }
  ' "$tmp"
}

read_status
s_count=$(complete_s_lines | wc -l)
s_count=$((s_count))

if [ "$s_count" -eq 0 ]; then
  partial=$(grep '^S,' "$tmp" | tail -n 1 | tr -d '\r' || true)
  if [ -n "$partial" ]; then
    echo "FAIL: S 줄은 수신되지만 32필드짜리 완전한 줄이 없습니다 ($PORT)"
    echo "마지막 S: $partial"
    echo "  이 줄의 필드 수: $(awk -F, '{print NF - 1}' <<<"$partial") (기대: 32)"
    echo "  - beebot_opencr이 아닌 다른 OpenCR 펌웨어일 가능성"
    echo "  - 또는 시리얼이 중간에 끊겨 필드가 잘린 경우"
    echo "  - raw 확인: ./test-firmware --raw"
  else
    echo "FAIL: S 상태 줄을 못 받았습니다 ($PORT)"
    echo "  - OpenCR에 beebot_opencr 펌웨어가 올라갔는지"
    echo "  - 포트가 맞는지: ls -l /dev/opencr /dev/ttyACM0"
    echo "  - USB를 다시 꽂거나 OpenCR RESET"
  fi
  exit 1
fi

last=$(complete_s_lines | tail -n 1)
fields=$(awk -F, '{print NF - 1}' <<<"$last")
say "OK: S ${s_count}줄, 필드 ${fields}개 (기대: 32개)"
say "포트: $PORT"
say ""

if [ "$RAW" = 1 ]; then
  say "--- S 줄 (최대 $LINES개, 완전한 32필드만) ---"
  complete_s_lines | head -n "$LINES" || true
  say ""
fi

IFS=',' read -r -a v <<<"$last"
if [ "${#v[@]}" -lt 33 ]; then
  echo "FAIL: S 필드가 부족합니다 (${#v[@]}개, S 포함)"
  echo "마지막 S: $last"
  echo "  beebot_opencr는 S 뒤에 32개 값이 와야 합니다."
  echo "  이 값이 8개뿐이면 beebot_opencr이 아닌 다른 펌웨어가 도는 중일 가능성이 큽니다."
  exit 1
fi
if [ "$fields" != 32 ]; then
  echo "WARN: S 필드 수가 32가 아닙니다. 펌웨어/프로토콜 버전을 확인하세요."
fi

printf 'wheel L : pos % .4f rad  vel % .4f rad/s\n' "${v[1]}" "${v[2]}"
printf 'wheel R : pos % .4f rad  vel % .4f rad/s\n' "${v[3]}" "${v[4]}"
printf 'joint1  : pos % .4f rad  vel % .4f rad/s  cur % .3f A\n' "${v[5]}" "${v[6]}" "${v[7]}"
printf 'joint2  : pos % .4f rad  vel % .4f rad/s  cur % .3f A\n' "${v[8]}" "${v[9]}" "${v[10]}"
printf 'joint3  : pos % .4f rad  vel % .4f rad/s  cur % .3f A\n' "${v[11]}" "${v[12]}" "${v[13]}"
printf 'joint4  : pos % .4f rad  vel % .4f rad/s  cur % .3f A\n' "${v[14]}" "${v[15]}" "${v[16]}"
printf 'joint5  : pos % .4f rad  vel % .4f rad/s  cur % .3f A\n' "${v[17]}" "${v[18]}" "${v[19]}"
printf 'gripper : pos % .4f m    vel % .4f m/s    cur % .3f A\n' "${v[20]}" "${v[21]}" "${v[22]}"

# 현재 자세를 유지하는 C 명령. 관절·그리퍼는 마지막 S의 위치를 그대로 쓴다.
current_cmd() {
  printf 'C,0,0,%s,%s,%s,%s,%s,%s' \
    "${v[5]}" "${v[8]}" "${v[11]}" "${v[14]}" "${v[17]}" "${v[20]}"
}

send_repeated() {
  local cmd=$1 count=${2:-20}
  for _ in $(seq "$count"); do
    printf '%s\n' "$cmd" >"$PORT"
    sleep 0.05
  done
}

if [ "$HOLD" = 1 ]; then
  say ""
  say "현재 자세 유지 명령 전송 (C,0,0,현재 관절...)"
  send_repeated "$(current_cmd)" 5
fi

if [ -n "$SEND" ]; then
  case "$SEND" in
    S,*) echo "FAIL: --send는 C 명령만 보낼 수 있습니다"; exit 2 ;;
    C,*) cmd=$SEND ;;
    *) cmd="C,$SEND" ;;
  esac
  say ""
  say "전송: $cmd"
  send_repeated "$cmd" 5
fi

if [ -n "$ARM" ]; then
  case "$ARM" in
    joint1) idx=5 ;;
    joint2) idx=8 ;;
    joint3) idx=11 ;;
    joint4) idx=14 ;;
    joint5) idx=17 ;;
    *) echo "FAIL: --arm은 joint1~joint5만 지원: $ARM"; exit 2 ;;
  esac
  [[ "$ARM_DELTA" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || { echo "FAIL: delta가 숫자가 아님: $ARM_DELTA"; exit 2; }
  target=$(awk -v a="${v[$idx]}" -v d="$ARM_DELTA" 'BEGIN { printf "%.6f", a + d }')
  cmd=$(current_cmd)
  # current_cmd의 해당 위치만 target으로 교체
  case "$ARM" in
    joint1) cmd="C,0,0,$target,${v[8]},${v[11]},${v[14]},${v[17]},${v[20]}" ;;
    joint2) cmd="C,0,0,${v[5]},$target,${v[11]},${v[14]},${v[17]},${v[20]}" ;;
    joint3) cmd="C,0,0,${v[5]},${v[8]},$target,${v[14]},${v[17]},${v[20]}" ;;
    joint4) cmd="C,0,0,${v[5]},${v[8]},${v[11]},$target,${v[17]},${v[20]}" ;;
    joint5) cmd="C,0,0,${v[5]},${v[8]},${v[11]},${v[14]},$target,${v[20]}" ;;
  esac
  say ""
  say "$ARM: ${v[$idx]} → $target rad (delta $ARM_DELTA)"
  say "전송: $cmd"
  send_repeated "$cmd" 20
fi

if [ -n "$GRIPPER" ]; then
  [[ "$GRIPPER" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || { echo "FAIL: gripper 값이 숫자가 아님: $GRIPPER"; exit 2; }
  cmd="C,0,0,${v[5]},${v[8]},${v[11]},${v[14]},${v[17]},$GRIPPER"
  say ""
  say "gripper: ${v[20]} → $GRIPPER m"
  say "전송: $cmd"
  say "NOTE: Current-based Position의 Goal Current가 0이면 움직이지 않을 수 있습니다."
  send_repeated "$cmd" 20
fi

if [ "$HOLD" = 1 ] || [ -n "$SEND" ] || [ -n "$ARM" ] || [ -n "$GRIPPER" ]; then
  sleep 0.3
  read_status
  last2=$(complete_s_lines | tail -n 1 || true)
  if [ -n "$last2" ]; then
    IFS=',' read -r -a v2 <<<"$last2"
    say ""
    printf '확인 joint1=% .4f  joint2=% .4f  gripper=% .4f m\n' \
      "${v2[5]}" "${v2[8]}" "${v2[20]}"
  fi
fi

say ""
say "PASS: S 프로토콜 수신"
if [ -z "$SEND" ] && [ -z "$ARM" ] && [ -z "$GRIPPER" ] && [ "$HOLD" = 0 ]; then
  say "로봇은 움직이지 않았습니다. 실제 동작 시험은 --hold/--arm/--gripper를 사용하세요."
fi
