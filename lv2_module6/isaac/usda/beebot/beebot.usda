                # pole_back_cam (fitted on the real robot 11-15, urdf/default/urdf.xacro pole_back_cam_joint): front camera turned 180 deg about the pole axis, 18 deg down, looking back
                #   D435 body mesh + materials as the front camera (no collision); optical frame = D435 RGB lens offset
                def Xform "pole_back_cam_link"
                {
                    quatf xformOp:orient = (0, -0.15643446, 0, 0.98768836)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (-0.281031, -0.000185, 0.436632)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                    def Xform "camera_rear_link" (
                        instanceable = false
                        prepend references = @./payloads/instances.usda@</Instances/camera_rear_link>
                    )
                    {
                        quatd xformOp:orient = (1, 0, 0, 0)
                        double3 xformOp:scale = (0.001000000047, 0.001000000047, 0.001000000047)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                        over "camera_rear_link" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </beebot/Looks/aluminum_d435>

                            over "glass" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                rel material:binding = </beebot/Looks/glass_black>
                            }
                        }
                    }

                    def Xform "pole_back_cam_color_optical_frame"
                    {
                        quatf xformOp:orient = (0.5, -0.5, 0.5, -0.5)
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (-0.0043, 0.0325, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                        def Camera "pole_back_cam_rgb" (
                            prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
                        )
                        {
                            float2 clippingRange = (0.01, 20)
                            float exposure:fStop = 5
                            float exposure:responsivity = 1.1026709
                            float exposure:time = 0.02
                            float focalLength = 15.2449
                            float focusDistance = 400
                            float horizontalAperture = 15.855
                            bool omni:kit:cameraLock = 1
                            float verticalAperture = 11.891
                            quatd xformOp:orient = (6.123233995736766e-17, 1, 0, 0)
                            double3 xformOp:scale = (1, 1, 1)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                        }
                    }
                }

