#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "beebot"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "beebot"
{
    over "Physics"
    {
        over "wheel_left_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wheel_right_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint3" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint4" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint5" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "gripper_left_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "gripper_right_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "wheel_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = 3
            uniform double mjc:forceRange:min = -3
            custom rel mjc:target
            append rel mjc:target = </beebot/Physics/wheel_left_joint>
        }

        def MjcActuator "wheel_right_joint_actuator"
        {
            uniform double mjc:forceRange:max = 3
            uniform double mjc:forceRange:min = -3
            custom rel mjc:target
            append rel mjc:target = </beebot/Physics/wheel_right_joint>
        }

        def MjcActuator "joint1_actuator"
        {
            uniform double mjc:forceRange:max = 4.099999904632568
            uniform double mjc:forceRange:min = -4.099999904632568
            custom rel mjc:target
            append rel mjc:target = </beebot/Physics/joint1>
        }

        def MjcActuator "joint2_actuator"
        {
            uniform double mjc:forceRange:max = 4.099999904632568
            uniform double mjc:forceRange:min = -4.099999904632568
            custom rel mjc:target
            append rel mjc:target = </beebot/Physics/joint2>
        }

        def MjcActuator "joint3_actuator"
        {
            uniform double mjc:forceRange:max = 4.099999904632568
            uniform double mjc:forceRange:min = -4.099999904632568
            custom rel mjc:target
            append rel mjc:target = </beebot/Physics/joint3>
        }

        def MjcActuator "joint4_actuator"
        {
            uniform double mjc:forceRange:max = 4.099999904632568
            uniform double mjc:forceRange:min = -4.099999904632568
            custom rel mjc:target
            append rel mjc:target = </beebot/Physics/joint4>
        }

        def MjcActuator "joint5_actuator"
        {
            uniform double mjc:forceRange:max = 4.099999904632568
            uniform double mjc:forceRange:min = -4.099999904632568
            custom rel mjc:target
            append rel mjc:target = </beebot/Physics/joint5>
        }

        def MjcActuator "gripper_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = 20
            uniform double mjc:forceRange:min = -20
            custom rel mjc:target
            append rel mjc:target = </beebot/Physics/gripper_left_joint>
        }

        def MjcActuator "gripper_right_joint_actuator"
        {
            uniform double mjc:forceRange:max = 20
            uniform double mjc:forceRange:min = -20
            custom rel mjc:target
            append rel mjc:target = </beebot/Physics/gripper_right_joint>
        }
    }
}

