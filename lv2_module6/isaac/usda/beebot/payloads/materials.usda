#usda 1.0
(
    "Visual materials for beebot (generated by apply_materials.py). Physics materials stay in Physics/physics.usda."
    metersPerUnit = 1
    upAxis = "Z"
)

def "beebot"
{
    def "Looks"
    {
        def Material "plastic_black" (
            doc = "TurtleBot3 waffle plates, DYNAMIXEL XM430, OpenMANIPULATOR-X frames, TB3 wheel hub"
        )
        {
            token outputs:surface.connect = </beebot/Looks/plastic_black/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.022)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "rubber_black" (
            doc = "TB3 TR-66 tire"
        )
        {
            token outputs:surface.connect = </beebot/Looks/rubber_black/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.015, 0.015)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "aluminum_profile" (
            doc = "2020 aluminum extrusion pole (clear anodized)"
        )
        {
            token outputs:surface.connect = </beebot/Looks/aluminum_profile/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.82)
                float inputs:metallic = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "aluminum_d435" (
            doc = "RealSense D435 aluminum housing"
        )
        {
            token outputs:surface.connect = </beebot/Looks/aluminum_d435/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.73, 0.75)
                float inputs:metallic = 1
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "glass_black" (
            doc = "RealSense D435 front cover glass (opaque, hides internals)"
        )
        {
            token outputs:surface.connect = </beebot/Looks/glass_black/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.01, 0.01, 0.012)
                float inputs:metallic = 0
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }

        def Material "steel_ball" (
            doc = "TB3 ball caster steel ball"
        )
        {
            token outputs:surface.connect = </beebot/Looks/steel_ball/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.85, 0.86)
                float inputs:metallic = 1
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }

        def Material "pla_blue" (
            doc = "3D-printed blue PLA parts: storage tray, basket rings, pole FL1/FL2 and camera brackets, gripper camera mount, wrist yaw bracket"
        )
        {
            token outputs:surface.connect = </beebot/Looks/pla_blue/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0497, 0.1193, 0.5639)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "battery" (
            doc = "LiPo battery pack"
        )
        {
            token outputs:surface.connect = </beebot/Looks/battery/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </beebot/Looks/plastic_black>

        over "base_footprint"
        {
            over "base_link"
            {
                over "wheel_left_link"
                {
                    over "wheel_left_link" (
                        instanceable = false
                    )
                    {
                        over "wheel_left_link"
                        {
                            over "tire" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                rel material:binding = </beebot/Looks/rubber_black>
                            }
                        }
                    }
                }

                over "wheel_right_link"
                {
                    over "wheel_right_link" (
                        instanceable = false
                    )
                    {
                        over "wheel_right_link"
                        {
                            over "tire" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                rel material:binding = </beebot/Looks/rubber_black>
                            }
                        }
                    }
                }

                over "pole_front_cam_link"
                {
                    over "camera_rear_link" (
                        instanceable = false
                    )
                    {
                        over "camera_rear_link" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </beebot/Looks/aluminum_d435>

                            over "glass" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                rel material:binding = </beebot/Looks/glass_black>
                            }
                        }
                    }
                }

                over "arm_base_link"
                {
                    over "shoulder_link"
                    {
                        over "upper_arm_link"
                        {
                            over "forearm_link"
                            {
                                over "wrist_link"
                                {
                                    over "gripper_link"
                                    {
                                        over "gripper_cam_link"
                                        {
                                            over "camera_wrist_link" (
                                                instanceable = false
                                            )
                                            {
                                                over "camera_wrist_link" (
                                                    prepend apiSchemas = ["MaterialBindingAPI"]
                                                )
                                                {
                                                    rel material:binding = </beebot/Looks/aluminum_d435>

                                                    over "glass" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding = </beebot/Looks/glass_black>
                                                    }

                                                    over "mount" (
                                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                                    )
                                                    {
                                                        rel material:binding = </beebot/Looks/pla_blue>
                                                    }
                                                }
                                            }
                                        }

                                        over "gripper_link_visual" (
                                            instanceable = false
                                        )
                                        {
                                            over "gripper_link_visual"
                                            {
                                                over "wrist_yaw_bracket" (
                                                    prepend apiSchemas = ["MaterialBindingAPI"]
                                                )
                                                {
                                                    rel material:binding = </beebot/Looks/pla_blue>
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                over "base_link"
                {
                    over "base_link"
                    {
                        over "storage" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </beebot/Looks/pla_blue>
                        }

                        over "pole" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </beebot/Looks/aluminum_profile>
                        }

                        over "caster_ball" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </beebot/Looks/steel_ball>
                        }

                        over "fl1_bracket" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </beebot/Looks/pla_blue>
                        }

                        over "fl2_bracket" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </beebot/Looks/pla_blue>
                        }

                        over "pole_cam_bracket" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </beebot/Looks/pla_blue>
                        }
                    }
                }

                over "storage_support" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </beebot/Looks/pla_blue>
                }

                over "battery_link"
                {
                    over "visual" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </beebot/Looks/battery>
                    }
                }
            }
        }
    }
}

