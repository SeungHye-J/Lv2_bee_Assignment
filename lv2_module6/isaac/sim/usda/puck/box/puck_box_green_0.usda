#usda 1.0
(
    defaultPrim = "puck"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./geo.usd@
    ]
    timeCodesPerSecond = 24
    upAxis = "Z"
)

over "puck" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.025

    over "box"
    {
        over "collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </puck/PhysicsMaterials/PLA> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform token physics:approximation = "convexHull"
            uniform token purpose = "guide"
        }

        def Material "Looks" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
            prepend inherits = </__class_mtl__/puck_box>
        )
        {
            string config:mtlx:version = "1.39"
            token outputs:mtlx:displacement.connect = </puck/box/Looks/mtlxdisplacement.outputs:out>
            token outputs:mtlx:surface.connect = </puck/box/Looks/mtlxstandard_surface.outputs:out>
            token outputs:surface.connect = </puck/box/Looks/mtlxstandard_preview.outputs:surface>

            def Shader "mtlxstandard_surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base
                color3f inputs:base_color.connect = </puck/box/Looks/mtlxpower1.outputs:out>
                float inputs:coat
                float inputs:coat_roughness
                float inputs:emission
                color3f inputs:emission_color
                float inputs:metalness
                vector3f inputs:normal.connect = </puck/box/Looks/mtlxnormalmap1.outputs:out>
                float inputs:specular
                color3f inputs:specular_color
                float inputs:specular_IOR
                float inputs:specular_roughness.connect = </puck/box/Looks/mtlximage7.outputs:out>
                float inputs:transmission
                token outputs:out
            }

            def Shader "mtlxpower1"
            {
                uniform token info:id = "ND_power_color3"
                color3f inputs:in1.connect = </puck/box/Looks/mtlxmix1.outputs:out>
                color3f inputs:in2 = (2.2, 2.2, 2.2)
                color3f outputs:out
            }

            def Shader "mtlxmix1"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg.connect = </puck/box/Looks/mtlxmultiply2.outputs:out>
                color3f inputs:fg.connect = </puck/box/Looks/mtlximage5.outputs:out>
                float inputs:mix.connect = </puck/box/Looks/mtlximage4.outputs:out>
                color3f outputs:out
            }

            def Shader "mtlximage5"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @../../../source/texture/puck/puck_box_basecolor_id0.png@ (
                    colorSpace = "srgb_texture"
                )
                color3f outputs:out
            }

            def Shader "mtlxmultiply2"
            {
                uniform token info:id = "ND_multiply_color3FA"
                color3f inputs:in1 = (0, 0.6824, 0.2588)
                color3f inputs:in1.connect = None
                float inputs:in2.connect = </puck/box/Looks/mtlxinvert1.outputs:out>
                color3f outputs:out
            }

            def Shader "mtlxinvert1"
            {
                uniform token info:id = "ND_invert_float"
                float inputs:in.connect = </puck/box/Looks/mtlximage4.outputs:out>
                float outputs:out
            }

            def Shader "mtlximage4"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @../../../source/texture/puck/puck_box_tagmask.png@
                float outputs:out
            }

            def Shader "mtlximage7"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @../../../source/texture/puck/puck_box_roughness.png@
                float outputs:out
            }

            def Shader "mtlxnormalmap1"
            {
                uniform token info:id = "ND_normalmap_float"
                vector3f inputs:in.connect = </puck/box/Looks/mtlximage6.outputs:out>
                float inputs:scale = 2
                vector3f outputs:out
            }

            def Shader "mtlximage6"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @../../../source/texture/puck/puck_box_normal.png@
                vector3f outputs:out
            }

            def Shader "mtlxdisplacement"
            {
                uniform token info:id = "ND_displacement_float"
                token outputs:out
            }

            def Shader "mtlxstandard_preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoatRoughness = 0.1
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:roughness = 0.2
                float inputs:roughness.connect = </puck/box/Looks/mtlxstandard_preview_texture_roughness.outputs:r>
                color3f inputs:specularColor = (1, 1, 1)
                token outputs:surface
            }

            def Shader "mtlxstandard_preview_uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                float2 inputs:fallback = (0, 0)
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "mtlxstandard_preview_texture_roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../../../source/texture/puck/puck_box_roughness.png@
                float2 inputs:st.connect = </puck/box/Looks/mtlxstandard_preview_uv.outputs:result>
                float outputs:r
            }
        }

        over "geo" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </puck/box/Looks>
        }
    }

    def "PhysicsMaterials"
    {
        def Material "PLA" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0.4
            float physics:staticFriction = 0.35
        }
    }
}

