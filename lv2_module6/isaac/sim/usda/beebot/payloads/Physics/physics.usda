        def PhysicsRevoluteJoint "wheel_left_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.035
            float drive:angular:physics:maxForce = 3
            float drive:angular:physics:stiffness = 0
            token drive:angular:physics:type = "force"
            float newton:velocityLimit = 461.97586
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </beebot/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </beebot/Geometry/base_footprint/base_link/wheel_left_link>
            point3f physics:localPos0 = (0, 0.1439, 0.023)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
