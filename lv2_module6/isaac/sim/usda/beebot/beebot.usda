                double radius = 1.0361764907836915
            }
            dictionary Top = {
                double3 position = (0.06884767717888385, 0.09082034010831479, 5)
                double radius = 1.88232479095459
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        string creator = "URDF USD Converter v0.3.2"
        dictionary omni_layer = {
