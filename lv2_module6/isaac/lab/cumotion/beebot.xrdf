  buffer_distance: {}
  ignore:
    arm_base_link:
    - shoulder_link
    - pole_front_cam_link
    - upper_arm_link
    shoulder_link:
    - upper_arm_link
    upper_arm_link:
    - forearm_link
    forearm_link:
    - wrist_link
    wrist_link:
    - gripper_link
    gripper_link:
    - finger_left_link
    - finger_right_link
    - gripper_cam_link
    finger_left_link:
    - gripper_cam_link
    - finger_right_link
    - wrist_link
    finger_right_link:
    - gripper_cam_link
    - wrist_link
    base_link:
    - arm_base_link
    - pole_front_cam_link
    gripper_cam_link:
    - wrist_link
