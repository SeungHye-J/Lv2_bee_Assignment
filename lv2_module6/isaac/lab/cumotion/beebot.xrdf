format: xrdf
format_version: 1.0
modifiers:
- set_base_frame: base_link
default_joint_positions:
  joint1: 0.0
  joint2: -1.9024
  joint3: 1.344
  joint4: 0.9023
  joint5: 0.0
cspace:
  joint_names:
  - joint1
  - joint2
  - joint3
  - joint4
  - joint5
  acceleration_limits:
  - 5.0
  - 5.0
  - 5.0
  - 5.0
  - 5.0
  jerk_limits:
  - 100.0
  - 100.0
  - 100.0
  - 100.0
  - 100.0
tool_frames:
- end_effector_link
collision:
  geometry: beebot_spheres
  buffer_distance:
    pole_front_cam_link: 0.005
    arm_base_link: 0.005
    shoulder_link: 0.005
    upper_arm_link: 0.005
    forearm_link: 0.005
    wrist_link: 0.005
    gripper_link: 0.005
    finger_left_link: 0.005
    finger_right_link: 0.005
    gripper_cam_link: 0.005
self_collision:
