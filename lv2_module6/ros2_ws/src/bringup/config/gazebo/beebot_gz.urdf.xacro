<?xml version="1.0"?>
<!-- Gazebo 카메라 테스트용 — 팀 URDF(urdf/<이름>/urdf.xacro, launch의 urdf:=)를 그대로 불러오고 Gazebo 전용 설정만 덧붙인다 (원본 수정 없음)
     - 로봇은 static(고정): 아직 gz_ros2_control이 없어 관절이 힘없이 처지지 않게. 위치는 Gazebo 화면에서 끌어 옮긴다
     - RGB-D 센서 2개를 URDF의 pole_cam_link · gripper_cam_link에 붙임 (D435 흉내: 640x480 · 가로 69° · 깊이 0.17~10m)
       Gazebo 카메라는 링크의 +x를 본다 = URDF camera 매크로의 _link 방향과 같음. 메시지 frame_id는 *_color_optical_frame
     사용: bringup/launch/gazebo_cam_test.launch.py -->
<robot name="beebot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="urdf" default=""/>
  <xacro:include filename="$(arg urdf)"/>

  <gazebo><static>true</static></gazebo>

  <xacro:macro name="gz_rgbd" params="name rate">
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="rgbd_camera">
        <always_on>1</always_on><update_rate>${rate}</update_rate><visualize>true</visualize>
        <topic>${name}</topic><gz_frame_id>${name}_color_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>10</far></clip>
          <depth_camera><clip><near>0.17</near><far>10</far></clip></depth_camera>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:gz_rgbd name="pole_cam" rate="30"/>
  <xacro:gz_rgbd name="gripper_cam" rate="15"/>
</robot>
