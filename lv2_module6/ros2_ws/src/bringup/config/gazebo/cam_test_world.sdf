<?xml version="1.0"?>
<!-- Gazebo 카메라 테스트 월드 — 팀 미로 코스(model://twin_closed_maze, lv2_module6/course) + 퍽 3개(3×3×6cm) + 장애물 상자
     로봇은 launch가 시작 칸 (-1.835, 2.757)에 +x 방향으로 놓는다. 퍽은 그 앞에 둠 -->
<sdf version="1.9"><world name="cam_test">
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<scene><ambient>0.5 0.5 0.5 1</ambient><background>0.8 0.85 0.9 1</background></scene>
<light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.5 0.2 -1</direction><cast_shadows>true</cast_shadows></light>
<model name="ground"><static>true</static><link name="l">
  <collision name="c"><geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry></collision>
  <visual name="v"><geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
</link></model>
<include><uri>model://twin_closed_maze</uri></include>
<model name="puck_cylinder_red"><static>true</static><pose>-1.45 2.80 0.03 0 0 0</pose><link name="l"><visual name="v">
  <geometry><cylinder><radius>0.015</radius><length>0.06</length></cylinder></geometry>
  <material><ambient>0.6 0.02 0.02 1</ambient><diffuse>0.6 0.02 0.02 1</diffuse></material></visual></link></model>
<model name="puck_box_green"><static>true</static><pose>-1.30 2.68 0.03 0 0 0.4</pose><link name="l"><visual name="v">
  <geometry><box><size>0.03 0.03 0.06</size></box></geometry>
  <material><ambient>0.02 0.35 0.05 1</ambient><diffuse>0.02 0.35 0.05 1</diffuse></material></visual></link></model>
<model name="puck_cylinder_blue"><static>true</static><pose>-1.20 2.86 0.03 0 0 0</pose><link name="l"><visual name="v">
  <geometry><cylinder><radius>0.015</radius><length>0.06</length></cylinder></geometry>
  <material><ambient>0.0 0.09 0.58 1</ambient><diffuse>0.0 0.09 0.58 1</diffuse></material></visual></link></model>
<model name="obstacle_box"><static>true</static><pose>-0.95 2.72 0.1 0 0 0.3</pose><link name="l"><visual name="v">
  <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
  <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual></link></model>
</world></sdf>
