<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS: 공유메모리(SHM) 칸을 32MB로 — 영상 1장(640x480 rgb ≈ 0.9MB)·점구름(≈4.9MB)이 기본 칸(512KB)보다 커서
     UDP 조각 전송으로 빠지며 대부분 손실되던 문제(Gazebo 29Hz → ROS 2Hz) 해결. 보내는 쪽(브리지)에만 적용하면 된다
     사용: FASTDDS_DEFAULT_PROFILES_FILE=<이 파일> (gazebo_cam_test.launch.py가 브리지에 설정) -->
<profiles xmlns="http://www.eprosima.com">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
      <maxMessageSize>33554432</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="large_shm" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>shm_large</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
