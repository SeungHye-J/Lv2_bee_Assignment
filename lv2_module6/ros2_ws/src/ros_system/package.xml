<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros_system</name>
  <version>0.1.0</version>
  <description>📦 제공 패키지 기동 — robot_state_publisher(URDF) · ros2_control(controller_manager) · RealSense ×2 · robot_localization EKF · SLAM(cuVSLAM·nvblox) · Nav2 (MoveIt 2는 설정 준비 후)</description>
  <maintainer email="todo@example.com">권형중</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>tf2_ros</depend>          <!-- map_tf_relay -->
  <depend>geometry_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>parallel_gripper_controller</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>control</exec_depend>
  <exec_depend>ml</exec_depend>
  <exec_depend>perception</exec_depend>   <!-- static_2d: static_esdf_slice -->
  <!-- 실기 PC에만 설치 (테스트베드 이미지에는 없음 — faker가 대신함) -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>      <!-- cuvslam_slam BEE_CUVSLAM_VIS -->
  <depend>visualization_msgs</depend>
  <!-- SLAM: cuVSLAM(PyCuVSLAM, pip)과 nvblox(isaac_ros_nvblox)는 Jetson에 따로 설치 — documents/jetson-orin-nano/CUVSLAM.md
       (테스트베드엔 GPU가 없어 의존성으로 걸지 않음 — launch가 시작할 때 확인) -->
  <exec_depend>rclpy</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>          <!-- cpp_helpers rewind /rewind -->
  <depend>action_msgs</depend>       <!-- cpp_helpers rewind 액션 상태 -->
  <!-- 진짜 Nav2 서버 (launch가 직접 띄움 — nav2_bringup은 시뮬레이션 의존성까지 끌어와 안 씀) -->
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>

  <depend>std_msgs</depend>          <!-- cuvslam_slam_cpp map_correction -->
  <build_depend>eigen</build_depend>  <!-- cuvslam_slam_cpp · slam_math.hpp -->
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
