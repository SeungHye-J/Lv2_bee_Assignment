#!/usr/bin/env bash
# rl_nav_correction 관리 — record(rosbag2) · report(png).
#   ./run record ~/bags/on
#   ./run report ~/bags/on ~/bags/off --out ~/report.png
# ROS 2와 이 워크스페이스를 source한다 (run-cli/run-rviz와 같은 결).
set -eo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
WS="$(cd "$HERE/../../../ros2_ws" 2>/dev/null && pwd || true)"
ROS_SETUP="/opt/ros/${ROS_DISTRO_NAME:-lyrical}/setup.bash"

# shellcheck disable=SC1090
source "$ROS_SETUP"
if [ -n "$WS" ] && [ -f "$WS/install/setup.bash" ]; then
  # shellcheck disable=SC1091
  source "$WS/install/setup.bash"
fi

cmd="${1:-report}"
[ $# -gt 0 ] && shift
case "$cmd" in
  record) exec "$HERE/record.sh" "$@" ;;
  report) exec python3 "$HERE/report.py" "$@" ;;
  *) echo "사용법: $0 record <bag> | report <bag...> [--labels ON OFF] [--out png]" >&2; exit 2 ;;
esac
