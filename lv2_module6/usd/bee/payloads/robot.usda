#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "bee"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "bee" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </bee/Physics/base_joint>,
        </bee/Physics/wheel_left_joint>,
        </bee/Physics/wheel_right_joint>,
        </bee/Physics/camera_rear_joint>,
        </bee/Physics/arm_mount_joint>,
        </bee/Physics/joint1>,
        </bee/Physics/joint2>,
        </bee/Physics/joint3>,
        </bee/Physics/joint4>,
        </bee/Physics/joint5>,
        </bee/Physics/gripper_joint>,
        </bee/Physics/gripper_mimic_joint>,
        </bee/Physics/camera_wrist_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </bee/Geometry/base_footprint/base_link>,
        </bee/Geometry/base_footprint/base_link/wheel_left_link>,
        </bee/Geometry/base_footprint/base_link/wheel_right_link>,
        </bee/Geometry/base_footprint/base_link/camera_rear_link>,
        </bee/Geometry/base_footprint/base_link/camera_rear_link/camera_rear_optical_frame>,
        </bee/Geometry/base_footprint/base_link/arm_base_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link/wrist_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link/wrist_link/gripper_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link/wrist_link/gripper_link/tcp_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link/wrist_link/gripper_link/finger_left_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link/wrist_link/gripper_link/finger_right_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link/wrist_link/gripper_link/camera_wrist_link>,
        </bee/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link/wrist_link/gripper_link/camera_wrist_link/camera_wrist_optical_frame>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "wheel_left_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "wheel_right_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "camera_rear_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "camera_rear_optical_frame" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }
                }

                over "arm_base_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "shoulder_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "upper_arm_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "forearm_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "wrist_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "gripper_link" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "finger_left_link" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                        }

                                        over "finger_right_link" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                        }

                                        over "camera_wrist_link" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                            over "camera_wrist_optical_frame" (
                                                prepend apiSchemas = ["IsaacSiteAPI"]
                                            )
                                            {
                                            }
                                        }

                                        over "tcp_link" (
                                            prepend apiSchemas = ["IsaacSiteAPI"]
                                        )
                                        {
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "base_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_rear_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "arm_mount_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_mimic_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_wrist_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

