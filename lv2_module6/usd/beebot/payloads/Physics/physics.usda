            append rel physics:body0 = </beebot/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link/wrist_link/gripper_link>
            custom rel physics:body1
            append rel physics:body1 = </beebot/Geometry/base_footprint/base_link/arm_base_link/shoulder_link/upper_arm_link/forearm_link/wrist_link/gripper_link/gripper_cam_link>
            point3f physics:localPos0 = (0.000273, -0.040325, 0.081681)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.57158357, -0.4169121, 0.41636932, -0.57106316)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    def Scope "PhysicsMaterials"
    {
        def Material "wheel_rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
