#!/usr/bin/env bash
# run-rdp-client — 모니터 없는 Jetson 원격 데스크톱 클라이언트 (RDP)
#
# 이 스크립트는 PC에서 실행한다. Jetson은 run-rdp-server로 xrdp를 한 번 설정해 둔다.
# SSH 터널(localhost:3389 -> Jetson:127.0.0.1:3389)을 열고 Remmina RDP를 실행한다.
# (모니터·더미 플러그가 있는 Jetson의 실제 화면 공유는 run-vnc-server / run-vnc-client — VNC)
set -euo pipefail

SSH_TARGET="${SSH_TARGET:-bee@bee.local}"
LOCAL_PORT="${LOCAL_PORT:-3389}"
REMOTE_PORT="${REMOTE_PORT:-3389}"
ACTION=start
NO_CLIENT=0

CONTROL_DIR="${XDG_RUNTIME_DIR:-/tmp}/bee-rdp-$(id -u)"
CONTROL_PATH="${CONTROL_DIR}/ssh-%r@%h:%p"
SSH_OPTS=(
  -o ControlMaster=auto
  -o "ControlPath=${CONTROL_PATH}"
  -o ControlPersist=300
  -o ServerAliveInterval=15
  -o ServerAliveCountMax=3
  -o ExitOnForwardFailure=yes
)

usage() {
  cat <<'EOF'
사용법:
  ./run-rdp-client [옵션]
  ./run-rdp-client --start
  ./run-rdp-client --status
  ./run-rdp-client --stop
  ./run-rdp-client --restart

옵션:
  -H, --host USER@HOST   SSH 대상 (기본 bee@bee.local) — RDP 사용자도 USER
  -l, --local-port N     PC 쪽 터널 포트 (기본 3389)
  -r, --remote-port N    Jetson 쪽 xrdp 포트 (기본 3389)
      --no-client        Remmina를 띄우지 않고 터널만 열기
      --start            터널 열기 + Remmina 실행 (기본 동작)
      --status           터널 상태 확인
      --stop             SSH 터널 종료
      --restart          터널 종료 후 다시 시작
  -h, --help             이 도움말

환경변수:
  SSH_TARGET, LOCAL_PORT, REMOTE_PORT

예:
  ./run-rdp-client
  ./run-rdp-client --host bee@10.2.12.110
  ./run-rdp-client --local-port 13389   # PC의 3389가 이미 사용 중일 때

접속하면 xrdp 로그인 창: 세션 Xorg · 사용자 bee · Jetson 계정 비밀번호
EOF
}

die() {
  echo "에러: $*" >&2
  exit 1
}

need_value() {
  [[ $# -ge 2 && -n "$2" ]] || die "$1 옵션에 값이 필요합니다."
}

port_in_use() {
  ss -ltnH 2>/dev/null | awk -v port=":${LOCAL_PORT}" '$4 ~ port"$" { found = 1 } END { exit !found }'
}

master_alive() {
  ssh "${SSH_OPTS[@]}" -O check "$SSH_TARGET" >/dev/null 2>&1
}

show_status() {
  echo "ssh target : ${SSH_TARGET}"
  echo "tunnel     : localhost:${LOCAL_PORT} -> 127.0.0.1:${REMOTE_PORT}"
  if master_alive; then
    echo "ssh master : alive"
  else
    echo "ssh master : not running"
  fi
  if port_in_use; then
    echo "local port : LISTEN"
    ss -ltnpH "sport = :${LOCAL_PORT}" 2>/dev/null || true
  else
    echo "local port : closed"
  fi
}

start_tunnel() {
  if port_in_use; then
    echo "PC의 ${LOCAL_PORT} 포트가 이미 사용 중입니다. 기존 터널을 재사용합니다."
    return 0
  fi

  echo "SSH 터널 생성: localhost:${LOCAL_PORT} -> ${SSH_TARGET}:127.0.0.1:${REMOTE_PORT}"
  ssh "${SSH_OPTS[@]}" -f -N \
    -L "${LOCAL_PORT}:127.0.0.1:${REMOTE_PORT}" \
    "$SSH_TARGET"

  sleep 1
  port_in_use || die "터널이 열리지 않았습니다. SSH 키/호스트/포트를 확인하세요."
  echo "터널 준비 완료."
}

stop_tunnel() {
  if master_alive; then
    ssh "${SSH_OPTS[@]}" -O exit "$SSH_TARGET" >/dev/null 2>&1 || true
    echo "SSH 터널을 종료했습니다."
  else
    echo "실행 중인 SSH 터널이 없습니다."
  fi
}

launch_rdp() {
  local user="${SSH_TARGET%%@*}"
  [[ "$user" == "$SSH_TARGET" ]] && user="$USER"
  if command -v remmina >/dev/null 2>&1; then
    echo "Remmina 실행: rdp://${user}@localhost:${LOCAL_PORT}"
    echo "xrdp 로그인 창: 세션 Xorg · 사용자 ${user} · Jetson 계정 비밀번호"
    remmina -c "rdp://${user}@localhost:${LOCAL_PORT}" &
    return 0
  fi

  cat >&2 <<EOF
RDP 클라이언트가 없습니다. 설치:
  sudo apt install -y remmina remmina-plugin-rdp

터널은 열려 있으므로 RDP 클라이언트에서 직접 접속해도 됩니다:
  localhost:${LOCAL_PORT} (사용자 ${user})
EOF
  return 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -H|--host)        need_value "$1" "${2:-}"; SSH_TARGET="$2"; shift 2 ;;
    -l|--local-port)  need_value "$1" "${2:-}"; LOCAL_PORT="$2"; shift 2 ;;
    -r|--remote-port) need_value "$1" "${2:-}"; REMOTE_PORT="$2"; shift 2 ;;
    --no-client)      NO_CLIENT=1; shift ;;
    --start)          ACTION=start; shift ;;
    --status)         ACTION=status; shift ;;
    --stop)           ACTION=stop; shift ;;
    --restart)        ACTION=restart; shift ;;
    -h|--help)        usage; exit 0 ;;
    *)                die "알 수 없는 옵션: $1 (--help 참고)" ;;
  esac
done

[[ "$LOCAL_PORT" =~ ^[0-9]+$ ]] || die "local port는 숫자여야 합니다: ${LOCAL_PORT}"
[[ "$REMOTE_PORT" =~ ^[0-9]+$ ]] || die "remote port는 숫자여야 합니다: ${REMOTE_PORT}"
(( LOCAL_PORT >= 1 && LOCAL_PORT <= 65535 )) || die "local port 범위 오류: ${LOCAL_PORT}"
(( REMOTE_PORT >= 1 && REMOTE_PORT <= 65535 )) || die "remote port 범위 오류: ${REMOTE_PORT}"

mkdir -p "$CONTROL_DIR"
chmod 700 "$CONTROL_DIR"

start_action() {
  start_tunnel
  if [[ "$NO_CLIENT" -eq 1 ]]; then
    echo "터널만 열었습니다. RDP 주소: localhost:${LOCAL_PORT}"
  else
    launch_rdp
  fi
}

case "$ACTION" in
  status)  show_status ;;
  stop)    stop_tunnel ;;
  restart) stop_tunnel; sleep 1; start_action ;;
  start)   start_action ;;
esac
