#!/usr/bin/env bash
# run-server — Jetson 화면 공유 서버 (x11vnc)
#
# 이 스크립트는 Jetson에서 실행한다. PC에서는 run-client를 사용한다.
# 기본값: DISPLAY=:0, 127.0.0.1:5900, VNC 비밀번호 ~/.vnc/passwd
set -euo pipefail

XDISPLAY="${X11VNC_DISPLAY:-:0}"
VNC_PORT="${VNC_PORT:-5900}"
VNC_PASSWD="${VNC_PASSWD:-$HOME/.vnc/passwd}"
LOG_FILE="${X11VNC_LOG:-$HOME/.vnc/x11vnc.log}"
PID_FILE="${X11VNC_PID:-$HOME/.vnc/x11vnc.pid}"
AUTH="${X11VNC_AUTH:-guess}"
WAIT_MS="${X11VNC_WAIT:-20}"
DEFER_MS="${X11VNC_DEFER:-40}"
# 저부하 프리셋 (x11vnc에 -quality 같은 색상 강제 옵션은 없음. 색상은 클라이언트가 정함)
SPEEDS="${X11VNC_SPEEDS:-dsl}"
WIREFRAME="${X11VNC_WIREFRAME:-1}"
SB_SECS="${X11VNC_SB:-15}"
# 저해상도 기본값: 전송량을 줄이기 위해 960x540으로 축소 전송한다.
# 원래 해상도로 쓰려면 X11VNC_SCALE=off ./run-server 또는 --scale off
SCALE="${X11VNC_SCALE:-960x540}"
# 실제 X 출력 해상도 변경 (물리 모니터에도 같이 적용됨).
# 기본 1280x720으로 자동 적용. 변경하지 않으려면 keep/off/none 또는 빈 값.
# 예: ./run-server --restart --xrandr keep
XRANDR_MODE="${X11VNC_XRANDR_MODE:-1280x720}"
XRANDR_OUTPUT="${X11VNC_OUTPUT:-}"
XRANDR_EXPLICIT=0
[[ -n "${X11VNC_XRANDR_MODE+set}" ]] && XRANDR_EXPLICIT=1
ACTION=start
FOREGROUND=0

usage() {
  cat <<'EOF'
사용법:
  ./run-server [옵션]
  ./run-server --start
  ./run-server --status
  ./run-server --stop
  ./run-server --restart

옵션:
  -d, --display :N        X display (기본 :0)
  -p, --port N            VNC 포트 (기본 5900)
      --password FILE     VNC 비밀번호 파일 (기본 ~/.vnc/passwd)
      --scale WxH         x11vnc 출력 축소 (기본 960x540, off면 축소 안 함)
                        예: 960x540 / 1280x720 / 1024x600 / 1/2 / off
      --xrandr MODE       Jetson 실제 출력 해상도 변경 후 시작 (기본 1280x720)
                        keep면 변경 안 함. 물리 모니터에도 같이 적용됨
      --speeds MODE       저속 링크 스케줄러 튜닝 (기본 dsl, off면 미사용)
                        예: dsl / modem / lan / off
      --sb SECS           무입력 시 폴링 간격 늦추기까지 대기 초 (기본 15, 0이면 끔)
      --wireframe         창 드래그 중 와이어프레임 표시 (기본 켜짐)
      --no-wireframe      와이어프레임 끄기
      --foreground        백그라운드 대신 현재 터미널에서 실행
      --start             x11vnc 시작 (기본 동작, 이미 실행 중이면 유지)
      --status            실행 상태만 확인
      --stop              x11vnc 종료
      --restart           종료 후 다시 시작 (설정 변경 적용용)
  -h, --help              이 도움말

환경변수:
  X11VNC_DISPLAY, VNC_PORT, VNC_PASSWD, X11VNC_LOG, X11VNC_PID,
  X11VNC_AUTH, X11VNC_WAIT, X11VNC_DEFER, X11VNC_SCALE,
  X11VNC_XRANDR_MODE, X11VNC_OUTPUT, X11VNC_SPEEDS, X11VNC_WIREFRAME,
  X11VNC_SB

보안:
  항상 -localhost로 실행한다. PC는 SSH 터널을 통해서만 접속한다.
EOF
}

die() {
  echo "에러: $*" >&2
  exit 1
}

need_value() {
  [[ $# -ge 2 && -n "$2" ]] || die "$1 옵션에 값이 필요합니다."
}

port_in_use() {
  ss -ltnH 2>/dev/null | awk -v port=":${VNC_PORT}" '$4 ~ port"$" { found = 1 } END { exit !found }'
}

listener_pids() {
  ss -ltnpH "sport = :${VNC_PORT}" 2>/dev/null |
    sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' |
    sort -u
}

show_status() {
  echo "display : ${XDISPLAY}"
  echo "address : 127.0.0.1:${VNC_PORT} (localhost only)"
  echo "passwd  : ${VNC_PASSWD}"
  echo "scale   : ${SCALE:-off (원본 해상도)}"
  echo "speeds  : ${SPEEDS:-off}"
  echo "wirefrm : ${WIREFRAME}"
  echo "sb      : ${SB_SECS}"
  echo "xrandr  : ${XRANDR_MODE:-keep (변경 안 함)}"
  echo "log     : ${LOG_FILE}"
  if port_in_use; then
    echo "state   : LISTEN"
    ss -ltnpH "sport = :${VNC_PORT}" 2>/dev/null || true
    local pids
    pids="$(listener_pids || true)"
    [[ -n "$pids" ]] && echo "pid     : ${pids}"
  else
    echo "state   : stopped"
  fi
}

stop_server() {
  local pids=""
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null &&
       [[ "$(cat "/proc/${pid}/comm" 2>/dev/null || true)" == "x11vnc" ]]; then
      pids="$pid"
    fi
  fi
  if [[ -z "$pids" ]]; then
    pids="$(listener_pids || true)"
  fi

  if [[ -z "$pids" ]]; then
    echo "x11vnc가 실행 중이 아닙니다."
    rm -f "$PID_FILE"
    return 0
  fi

  echo "x11vnc 종료: ${pids}"
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
  for _ in $(seq 1 20); do
    if ! port_in_use; then
      rm -f "$PID_FILE"
      echo "종료됨."
      return 0
    fi
    sleep 0.2
  done

  echo "정상 종료되지 않아 강제 종료합니다." >&2
  # shellcheck disable=SC2086
  kill -9 $pids 2>/dev/null || true
  rm -f "$PID_FILE"
}

apply_xrandr() {
  case "${XRANDR_MODE,,}" in
    ""|keep|off|none) echo "xrandr 유지 (실제 해상도 변경 안 함)"; return 0 ;;
  esac
  command -v xrandr >/dev/null 2>&1 || die "xrandr가 없습니다. Jetson에서 'sudo apt install -y x11-xserver-utils' 실행"

  # SSH에서도 동작하도록 XAUTHORITY 후보를 순서대로 시도
  local cands=()
  [[ -n "${XAUTHORITY:-}" ]] && cands+=("$XAUTHORITY")
  cands+=("/run/user/$(id -u)/gdm/Xauthority" "$HOME/.Xauthority")
  local xa="" c
  for c in "${cands[@]}"; do
    if [[ -r "$c" ]] && DISPLAY="$XDISPLAY" XAUTHORITY="$c" xrandr --current >/dev/null 2>&1; then
      xa="$c"
      break
    fi
  done
  [[ -n "$xa" ]] || die "X 세션에 접근할 수 없습니다. Jetson 모니터에서 bee로 그래픽 로그인되어 있는지 확인"

  local out="$XRANDR_OUTPUT"
  if [[ -z "$out" ]]; then
    out="$(DISPLAY="$XDISPLAY" XAUTHORITY="$xa" xrandr --current | awk '$2=="connected"{print $1; exit}')"
  fi
  [[ -n "$out" ]] || die "연결된 디스플레이 출력을 찾지 못했습니다 (xrandr --current 확인)"

  local modes
  modes="$(DISPLAY="$XDISPLAY" XAUTHORITY="$xa" xrandr --current | awk -v o="$out" '/^[^[:space:]]/{p=($1==o)} p && /^[[:space:]]+[0-9]+x[0-9]+/{print $1}')"
  if ! printf '%s\n' "$modes" | grep -qx "$XRANDR_MODE"; then
    if [[ "$XRANDR_EXPLICIT" -eq 1 ]]; then
      echo "출력 ${out}에서 모드 ${XRANDR_MODE}를 지원하지 않습니다. 사용 가능:" >&2
      printf '%s\n' "$modes" >&2
      exit 1
    fi
    echo "경고: 출력 ${out}에서 기본 모드 ${XRANDR_MODE} 미지원. 실제 해상도는 그대로 둡니다. 사용 가능:" >&2
    printf '%s\n' "$modes" >&2
    return 0
  fi

  echo "xrandr 적용: ${out} -> ${XRANDR_MODE}"
  DISPLAY="$XDISPLAY" XAUTHORITY="$xa" xrandr --output "$out" --mode "$XRANDR_MODE" \
    || die "xrandr 적용 실패 (출력: ${out}, 모드: ${XRANDR_MODE})"
}

start_server() {
  command -v x11vnc >/dev/null 2>&1 || die "x11vnc가 없습니다. Jetson에서 'sudo apt install -y x11vnc' 실행"

  if [[ ! -f "$VNC_PASSWD" ]]; then
    if [[ -t 0 && -t 1 ]]; then
      echo "VNC 비밀번호 파일이 없어 새로 만듭니다: ${VNC_PASSWD}"
      mkdir -p "$(dirname "$VNC_PASSWD")"
      x11vnc -storepasswd
    else
      die "VNC 비밀번호 파일이 없습니다: ${VNC_PASSWD} (Jetson에서 x11vnc -storepasswd 실행)"
    fi
  fi

  # 실제 해상도 변경이 요청되면 x11vnc 기동 전에 적용 (모니터+VNC 둘 다 영향)
  apply_xrandr

  if port_in_use; then
    echo "이미 ${VNC_PORT} 포트에서 x11vnc가 실행 중입니다."
    show_status
    return 0
  fi

  mkdir -p "$(dirname "$LOG_FILE")" "$(dirname "$PID_FILE")"

  local cmd=(
    x11vnc
    -display "$XDISPLAY"
    -auth "$AUTH"
    -forever
    -shared
    -rfbauth "$VNC_PASSWD"
    -localhost
    -rfbport "$VNC_PORT"
    -wait "$WAIT_MS"
    -defer "$DEFER_MS"
  )
  # SCALE=off/none/orig/1/1x1 이면 축소 없이 원본 해상도로 실행
  if [[ -n "$SCALE" && ! "${SCALE,,}" =~ ^(off|none|orig|1|1x1)$ ]]; then
    cmd+=(-scale "$SCALE")
  fi
  # 저속 링크 스케줄러 튜닝 (dsl/modem/lan 또는 rd,bw,lat)
  if [[ -n "$SPEEDS" && ! "${SPEEDS,,}" =~ ^(off|none)$ ]]; then
    cmd+=(-speeds "$SPEEDS")
  fi
  # 창 드래그 중 전체 다시 그리기 대신 와이어프레임 (저속 링크에서 체감 큼)
  if [[ "${WIREFRAME,,}" =~ ^(1|on|yes|true)$ ]]; then
    cmd+=(-wireframe)
  else
    cmd+=(-nowireframe)
  fi
  # 평소엔 -nap(기본값)으로 쉬고, 무입력 SB_SECS초 후 폴링을 더 늦춤
  cmd+=(-nap -sb "$SB_SECS")

  # 실제 기동 명령행을 로그에 남긴다 (적용 여부 증거용)
  printf '=== %s CMD: %s\n' "$(date '+%F %T')" "${cmd[*]}" >>"$LOG_FILE"

  if [[ "$FOREGROUND" -eq 1 ]]; then
    echo "x11vnc를 foreground로 실행합니다. 종료: Ctrl-C"
    exec "${cmd[@]}"
  fi

  nohup "${cmd[@]}" >"$LOG_FILE" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" >"$PID_FILE"
  sleep 1

  if ! kill -0 "$pid" 2>/dev/null; then
    echo "x11vnc 시작 실패. 로그:" >&2
    tail -30 "$LOG_FILE" >&2 || true
    exit 1
  fi

  echo "x11vnc 시작됨 (pid ${pid})"
  echo "주소: 127.0.0.1:${VNC_PORT} (SSH 터널 필요)"
  echo "로그: ${LOG_FILE}"
  show_status
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--display)   need_value "$1" "${2:-}"; XDISPLAY="$2"; shift 2 ;;
    -p|--port)      need_value "$1" "${2:-}"; VNC_PORT="$2"; shift 2 ;;
    --password)     need_value "$1" "${2:-}"; VNC_PASSWD="$2"; shift 2 ;;
    --scale)        need_value "$1" "${2:-}"; SCALE="$2"; shift 2 ;;
    --xrandr)       need_value "$1" "${2:-}"; XRANDR_MODE="$2"; XRANDR_EXPLICIT=1; shift 2 ;;
    --speeds)       need_value "$1" "${2:-}"; SPEEDS="$2"; shift 2 ;;
    --sb)           need_value "$1" "${2:-}"; SB_SECS="$2"; shift 2 ;;
    --wireframe)    WIREFRAME=1; shift ;;
    --no-wireframe) WIREFRAME=0; shift ;;
    --foreground)   FOREGROUND=1; shift ;;
    --start)        ACTION=start; shift ;;
    --status)       ACTION=status; shift ;;
    --stop)         ACTION=stop; shift ;;
    --restart)      ACTION=restart; shift ;;
    -h|--help)      usage; exit 0 ;;
    *)              die "알 수 없는 옵션: $1 (--help 참고)" ;;
  esac
done

[[ "$VNC_PORT" =~ ^[0-9]+$ ]] || die "포트는 숫자여야 합니다: ${VNC_PORT}"
(( VNC_PORT >= 1 && VNC_PORT <= 65535 )) || die "포트 범위 오류: ${VNC_PORT}"
[[ "$SB_SECS" =~ ^[0-9]+$ ]] || die "--sb 값은 숫자(초)여야 합니다: ${SB_SECS}"

case "$ACTION" in
  status)  show_status ;;
  stop)    stop_server ;;
  restart) stop_server; start_server ;;
  start)   start_server ;;
esac
